# Express API
API_PORT=4000

# SQLite database file (relative to the API process working directory)
SQLITE_DB_PATH=server/portal.sqlite

# Optional API URL override; normally the Vite /api proxy is used
# VITE_API_URL=http://localhost:4000/api

# Initial administrator account (used only when the users table is empty)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_DEPARTMENT=
